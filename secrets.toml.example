# คัดลอกเป็น .streamlit/secrets.toml (ห้าม commit) หรือวางในหน้า Secrets ของ Streamlit Cloud
GEMINI_API_KEY = "..."             # ใช้กับโมเดล gemini-* (ค่าเริ่มต้น: gemini-3.7-flash)
APP_PASSWORD = "ตั้งรหัสผ่านของคุณ"   # แนะนำ: กันคนอื่นใช้ API key / แก้ข้อมูลเรียนรู้

# เก็บข้อมูลถาวร (เลือกอย่างใดอย่างหนึ่ง; ถ้าตั้งทั้งคู่จะใช้ Google Sheets)
SHEETS_URL = "https://script.google.com/macros/s/.../exec"   # Web app URL จาก Apps Script (apps_script/Code.gs)
SHEETS_TOKEN = "รหัสลับเดียวกับ TOKEN ใน Code.gs"
# GITHUB_TOKEN = "github_pat_..."   # ทางเลือก: GitHub Gist
# GIST_ID = "..."
